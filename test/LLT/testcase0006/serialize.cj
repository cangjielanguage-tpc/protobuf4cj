// DEPENDENCE: ./build.sh ./example.proto
 EXEC: bash build.sh %import-path %L %l ffi-typecast.o

from std import collection.*
from std import io.*
import foo.* // The foo package is generated by the protobuf-gen-cj plugin.

@OverflowWrapping
main() {
    var vt = ValueTypes()
    vt.d1 = UInt32(2**31 - 1)
    vt.d2 = Int32(-2**31 + 2)
    vt.d3 = UInt64(2**62 - 3)
    vt.d4 = Int64(-2**63 + 4)
    vt.d5 = Int32(-2**31 + 5)
    vt.d6 = Int32(-2**31 + 6)
    vt.d7 = UInt32(2**32 - 7)
    vt.d8 = Int64(-2**63 + 8)
    vt.d9 = Int64(-2**63 + 9)
    vt.d10 = UInt64(2**62 - 10)
    vt.d11 = Float64(3.141592535)
    vt.f1 = Float32(3.1415926)
    vt.b1 = Array<UInt8>([3, 1, 4, 1, 5, 9, 2, 6])
    vt.s1 = "value types test"
    vt.flag = true

    var b = vt.pack()
    println("cangjie, serialize result: ${b}")

    var vt1 = ValueTypes()
    vt1.unpack(b)
    println("cangjie to cangjie, deserialize result: ${vt1}")
    return
}
