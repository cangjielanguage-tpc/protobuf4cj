// DEPENDENCE: ./build.sh ./example.proto
 EXEC: bash build.sh %import-path %L %l ffi-typecast.o

from std import collection.*
from std import io.*
import foo.* // The foo package is generated by the protobuf-gen-cj plugin.

main() {
    var p = Person()
    p.name = "test"
    p.id = 1
    p.email = "test@huawei.com"

    // set Person_PhoneNumber_Comment
    var ppnc = Person_PhoneNumber_Comment()
    ppnc.comment1 = "colleague"

    // set Person_PhoneNumber
    var ppn = Person_PhoneNumber()
    ppn.number = "12345678901"
    ppn.type_ = Person_PhoneType.WORK
    ppn.comment.append(ppnc)
    p.phone = ppn
    var b = p.pack()

    println("Serialize result: ${b}")
    return
}
