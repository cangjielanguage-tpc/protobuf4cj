// DEPENDENCE: ./build.sh ./example.proto
 EXEC: bash build.sh %import-path %L %l ffi-typecast.o

from std import collection.*
from std import io.*
import foo.* // The foo package is generated by the protobuf-gen-cj plugin.

main() {
    var p = Person()
    p.name = "test"
    p.id = 1
    p.email = "test@huawei.com"
    var b = p.pack()
    println("Serialize result: ${b}")

    //let out: Bytes = Array<UInt8>(b.size, item: 0)
    var writer = SimpleWriter(b.size)
    p.pack(writer)
    let out: Bytes = writer.data

    var p2 = Person()
    p2.unpack(out)
    println("p2 = ${p2}")
    if(!p.name.equals("test") || p.id != 1 || !p.email.equals("test@huawei.com")) {
        return -1
    }

    return 0
}
