// DEPENDENCE: ./build.sh ./example.proto
 EXEC: bash build.sh %import-path %L %l ffi-typecast.o

from std import collection.*
from std import io.*
import foo.* // The foo package is generated by the protobuf-gen-cj plugin.

main() {
    var t = Title()
    // set title1
    var t1 = Title1()
    t1.name = "title1"
    t1.version = "v1.0"
    t.title1 = t1

    // set title2
    var t2 = Title2()
    t2.author = "zhangsan"
    t2.category = "science"
    t.title2 = t2

    // set title3
    var t3 = Title3()
    t3.pages = 125
    t3.date = "2022.05.31"
    t3.property = "prose"
    t.title3 = t3

    var b = t.pack()
    println("size: ${b.size}")
    println("Serialize result: ${b}")
    return
}
