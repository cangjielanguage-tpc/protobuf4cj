// DEPENDENCE: ./build.sh ./example.proto
 EXEC: bash build.sh %import-path %L %l ffi-typecast.o

from std import collection.*
from std import io.*
import foo.* // The foo package is generated by the protobuf-gen-cj plugin.

main() {
    var p = Person()
    p.name = "zhangsan"
    p.phone = "1234567890"
    p.email = "zhangsan.qq.com"
    p.age = 26
    p.gender = Gender.MAN
    var family = p.familyList

    family.put("father", 50)
    family.put("mother", 50)

    var b = p.pack()
    println("size: ${b.size}")
    println("Serialize result: ${b}")

    var p1 = Person()
    p1.unpack(b)
    println(p1)
    for ((k, v) in p.familyList) {
        println("family: ${k}, age: ${v}")
    }
    return
}
