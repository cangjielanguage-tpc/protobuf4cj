// DEPENDENCE: ./build.sh ./example.proto
 EXEC: bash build.sh %import-path %L %l ffi-typecast.o

from std import collection.*
from std import io.*
import foo.* // The foo package is generated by the protobuf-gen-cj plugin.

main() {
    var p = Person()
    p.name = "xiaowang"
    p.email = "xiaowang@huawei.com"
    var b = p.pack()
    println("Serialize result: ${b}")

    var p2 = Person()
    p2.unpack(b)
    println("p2 = ${p2}")
    if(!p.name.equals("xiaowang") || !p.email.equals("xiaowang@huawei.com")) {
        return -1
    }

    return 0
}
